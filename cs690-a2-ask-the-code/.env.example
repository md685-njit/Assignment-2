# Copy this file to .env and fill it in. Never commit .env; it holds your key.
#
#     cp .env.example .env          (macOS and Linux)
#     copy .env.example .env        (Windows)

# Paste your key after ONE of these two lines. Leave the other one empty.
# A key from platform.claude.com starts with sk-ant-. A key from
# platform.openai.com starts with sk-.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only needed if you pasted both keys above: set this to anthropic or openai
# to say which one to use. Leave it empty if you only pasted one key.
AI_PROVIDER=

# Leave empty to use the default model for your provider. Set it only if you
# want a different model (check the name on your provider's models page).
AI_MODEL=

# Step 0 of the handout: look up today's price for your model on your
# provider's own pricing page and put both numbers here, in dollars per
# million tokens. Do not copy these from anywhere else; prices change.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
